<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ApiTestSuite" parallel="classes" thread-count="4">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Simulations">
        <packages>
            <package name="testSimulations"/>
        </packages>
    </test>

    <test name="Restricted">
        <packages>
            <package name="testRestricted"/>
        </packages>
    </test>
</suite>
